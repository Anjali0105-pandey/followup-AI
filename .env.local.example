# Copy to .env.local and fill in. Everything except the optional block is
# required — the app will not start without DATABASE_URL, and sign-in will not
# work without the Clerk keys.

# --- Database (required) -----------------------------------------------------
# Neon Postgres connection string: Neon console → your project → Connection
# string. Use the `-pooler` host. Run `npm run seed` once to create the schema
# and load the demo workspace.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Auth (required) ---------------------------------------------------------
# Clerk dashboard → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Encryption (required) ---------------------------------------------------
# AES-256 key protecting user-supplied AI keys at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every stored user key undecryptable; those users fall
# back to the server key (or mock mode) and must re-enter their own.
ENCRYPTION_KEY=

# --- Admin (required for /admin) ---------------------------------------------
# Comma-separated emails granted the admin panel and the demo-data reset.
# Re-evaluated on every sign-in, so removing an address revokes access.
ADMIN_EMAILS=you@example.com

# --- AI (optional) -----------------------------------------------------------
# Without a key here the app runs on local rule-based generation ("mock mode")
# and every screen still works. Users can also supply their own key in
# Settings, which takes precedence over this one.
GEMINI_API_KEY=

# Optional AI tuning.
# GEMINI_MODEL=gemini-3.6-flash
# Thinking level for drafting and refinement: minimal | low | medium | high |
# default. Lower is faster; extraction always uses the model default.
# GEMINI_WRITE_THINKING=low
# Hard ceiling on a single model call, in ms.
# GEMINI_TIMEOUT_MS=45000

# --- Debug (optional) --------------------------------------------------------
# DEBUG_SQL=1 logs every statement with its duration and a running count,
# which makes an N+1 or an accidentally sequential await chain obvious.
# DEBUG_SQL=1
